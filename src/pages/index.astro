color:var(--lime)}.primary:hover{background:#d2ff95;color:#17200e;transform:translateY(-2px)}.secondary:hover{background:#22281d}.hero-foot{display:flex;gap:20px;flex-wrap:wrap;color:var(--muted);font:11px var(--mono);letter-spacing:1px;margin-top:42px}.terminal{border:1px solid #455138;background:#171b15;box-shadow:14px 14px 0 #1c2318;transform:rotate(1deg);font-family:var(--mono);font-size:14px;min-width:0}.terminal-title{display:flex;align-items:center;gap:18px;padding:15px 17px;border-bottom:1px solid var(--line);font-size:12px;color:var(--muted)}.term-end{margin-left:auto}.window-dots{display:flex;gap:6px}.window-dots i{height:7px;width:7px;border-radius:50%;background:#5c6554}.window-dots i:first-child{background:#b9ca9b}.terminal-content{padding:23px 26px 10px}.terminal-content p{margin:0 0 12px}.prompt,.lime{color:var(--lime)}.prompt{margin-right:8px}.output{color:var(--muted);padding-left:21px;line-height:1.85;margin-bottom:23px!important}.terminal-repos{display:grid;grid-template-columns:1fr 1fr;padding-left:21px;color:var(--lime);gap:6px;margin:16px 0 25px}.cursor{display:inline-block;width:8px;height:16px;vertical-align:middle;background:var(--lime);animation:blink 1.3s steps(2,start) infinite}.terminal-bottom{padding:12px 18px;border-top:1px solid var(--line);font-size:10px;display:flex;justify-content:space-between;color:var(--muted)}.stat-strip{display:grid;grid-template-columns:1fr 1.4fr 1.2fr;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:28px 0}.stat-strip>div{display:flex;align-items:center;gap:20px;padding:0 30px;border-right:1px solid var(--line)}.stat-strip>div:first-child{padding-left:0}.stat-strip>div:last-child{border:0}.stat-strip strong{font-size:38px;font-weight:500;letter-spacing:-1px}.stat-strip span{color:var(--muted);font-size:13px;max-width:150px}.stat-strip .stat-text{display:block;padding-left:45px}.stat-text .small-label{font:10px var(--mono);letter-spacing:1px}.stat-text p{font-size:16px;margin:5px 0