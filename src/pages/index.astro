---
import repositories from '../data/repositories.json';
const repos = repositories.filter(r => !r.fork && !r.private);
const featured = ['portop','auroraOS','pkgtui','termdock','qawk'];
const other = repos.filter(r => !featured.includes(r.name));
const repo = (name: string) => repos.find(r => r.name === name)!;
const stars = repos.reduce((n,r) => n+r.stargazers_count,0);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="description" content="Luca Padovan — Platform & Senior Software Engineer in Bologna, Italy. Linux, embedded systems, platform engineering, and open-source developer tools."/>
<link rel="canonical" href="https://lucapadovan.dev/"/>
<meta property="og:title" content="Luca Padovan · Software Engineer"/><meta property="og:description" content="Linux systems. Useful tools. Open source. Explore the work of Luca Padovan."/><meta property="og:type" content="website"/><meta property="og:url" content="https://lucapadovan.dev/"/>
<meta name="theme-color" content="#111626"/><title>Luca Padovan · Software Engineer</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23111626'/%3E%3Cpath d='m15 20 13 12-13 12M34 44h15' fill='none' stroke='%23c1b3ff' stroke-width='6'/%3E%3C/svg%3E"/>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="page-shell">
<header><a class="wordmark" href="#" aria-label="Luca Padovan home"><span class="mark">lp.</span><span class="brand-name">Luca Padovan</span></a><nav aria-label="Main navigation"><a href="#projects">Projects</a><a href="#about">About</a><a href="#contact">Contact</a></nav><a class="header-gh" href="https://github.com/padovanl" target="_blank" rel="noopener noreferrer">GitHub</a></header>
<main id="main">
<section class="hero" aria-labelledby="hero-title">
<div class="hero-copy"><div class="eyebrow"><span>PLATFORM & SOFTWARE ENGINEER</span><span class="location">BOLOGNA, ITALY</span></div>
<p class="hello">Hi, I'm Luca Padovan.</p><h1 id="hero-title">A curious mind.<br/><span>A builder at heart.</span></h1>
<p class="intro">I build Linux systems and tools that make a developer's day a little easier. From embedded platforms to open-source software, I like understanding how things work — and making them work better.</p>
<div class="hero-actions"><a class="button primary" href="#projects">Explore the work</a><a class="button secondary" href="https://github.com/padovanl" target="_blank" rel="noopener noreferrer">GitHub profile</a></div>
<a class="linkedin-hero" href="https://www.linkedin.com/in/lucapadovan/" target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a><div class="hero-foot"><span>LINUX</span><span>EMBEDDED</span><span>PLATFORM ENGINEERING</span><span>OPEN SOURCE</span></div></div>

</section>
<div class="stat-strip"><div><strong data-total-repos>{repos.length}</strong><span>public repositories</span></div><div><strong data-total-stars>{stars}</strong><span>GitHub stars across my projects</span></div><div class="stat-text"><span class="small-label">THE COMMON THREAD</span><p>Practical software.<br/>A Linux state of mind.</p></div></div>
<section id="projects" class="projects section" aria-labelledby="projects-title"><div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2 id="projects-title">Small ideas.<br/>Real-world tools.</h2></div><p>A few things I've built, maintained,<br class="desktop-break"/> and put out into the world.</p></div>
<div class="project-grid">
<article class="project featured-project"><div class="project-top"><span class="project-number">01</span><span class="badge">NETWORKING · GO</span><span class="repo-stars" data-stars="portop">☆ {repo('portop').stargazers_count}</span></div><div class="project-copy"><h3>portop</h3><p>What's really using your ports?</p><p class="description">An htop-style view of network ports and the processes behind them. Inspect systemd services and Docker containers in the terminal, web dashboard, or Cockpit.</p></div><a class="project-image" href="https://padovanl.github.io/portop/" target="_blank" rel="noopener noreferrer" aria-label="Visit the Portop website"><img src="./assets/portop-dashboard.png" alt="Portop web dashboard showing network ports, processes, and services" width="1200" height="700" loading="lazy"/></a><div class="project-links"><a href="https://github.com/padovanl/portop" target="_blank" rel="noopener noreferrer">Repository</a><a href="https://padovanl.github.io/portop/" target="_blank" rel="noopener noreferrer">Website & docs</a><span data-release="portop"></span></div></article>
<article class="project aurora-project"><div class="project-top"><span class="project-number">02</span><span class="badge">LINUX · DEBIAN</span><span class="repo-stars" data-stars="auroraOS">☆ {repo('auroraOS').stargazers_count}</span></div><div class="project-copy"><h3>Aurora OS</h3><p>A Linux desktop, with a fresh perspective.</p><p class="description">A developer-ready Debian distribution with a custom macOS-inspired desktop, built-in AI, snapshots, and everyday development tools.</p></div><a class="project-image" href="https://padovanl.github.io/auroraOS/" target="_blank" rel="noopener noreferrer" aria-label="Visit the Aurora OS website"><img src="./assets/aurora-desktop.png" alt="The Aurora OS desktop with its custom interface and application dock" width="1200" height="700" loading="lazy"/></a><div class="project-links"><a href="https://github.com/padovanl/auroraOS" target="_blank" rel="noopener noreferrer">Repository</a><a href="https://padovanl.github.io/auroraOS/" target="_blank" rel="noopener noreferrer">Website & docs</a><span data-release="auroraOS"></span></div></article>
<article class="project compact-project"><div class="project-top"><span class="project-number">03</span><span class="badge">PACKAGES · GO</span><span class="repo-stars" data-stars="pkgtui">☆ {repo('pkgtui').stargazers_count}</span></div><div class="project-copy"><div class="compact-symbol" aria-hidden="true">[pkg]</div><h3>pkgtui</h3><p>One terminal. Your package managers.</p><p class="description">Search, install, remove, and upgrade packages from APT, Snap, Flatpak, Homebrew, and MacPorts in one terminal interface.</p></div><div class="project-links"><a href="https://github.com/padovanl/pkgtui" target="_blank" rel="noopener noreferrer">Repository</a><a href="https://github.com/padovanl/pkgtui#readme" target="_blank" rel="noopener noreferrer">Read the docs</a><span data-release="pkgtui"></span></div></article>
<article class="project compact-project"><div class="project-top"><span class="project-number">04</span><span class="badge">TERMINAL · GO</span><span class="repo-stars" data-stars="termdock">☆ {repo('termdock').stargazers_count}</span></div><div class="project-copy"><div class="compact-symbol panes" aria-hidden="true">[ | ]</div><h3>termdock</h3><p>Your sessions, still running.</p><p class="description">A terminal multiplexer written from scratch in Go. Split panes, persistent sessions, detach and reattach — even from a different machine.</p></div><div class="project-links"><a href="https://github.com/padovanl/termdock" target="_blank" rel="noopener noreferrer">Repository</a><a href="https://padovanl.github.io/termdock/" target="_blank" rel="noopener noreferrer">Website & docs</a><span data-release="termdock"></span></div></article>
<article class="project qawk-project"><div class="project-top"><span class="project-number">05</span><span class="badge">OTA · DEVICE FLEETS</span><span class="repo-stars" data-stars="qawk">☆ {repo('qawk').stargazers_count}</span></div><div class="qawk-layout"><div class="project-copy"><h3>qawk</h3><p>Updates that move together.</p><p class="description">A hawkBit-compatible OTA update server with release channels, staged rollouts, and multi-device orchestration. Built for managing releases across connected device fleets.</p></div><div class="qawk-capabilities"><span class="small-label">RELEASE MANAGEMENT</span><div><span>Release channels</span><span>Staged rollouts</span><span>Device orchestration</span><span>hawkBit compatibility</span></div></div></div><div class="project-links"><a href="https://github.com/padovanl/qawk" target="_blank" rel="noopener noreferrer">Repository</a><a href="https://github.com/padovanl/qawk#readme" target="_blank" rel="noopener noreferrer">Read the docs</a><span data-release="qawk"></span></div></article></div>
<details class="archive"><summary><span>More from the workbench</span><span class="archive-count">{other.length} more repositories</span><span class="expand" aria-hidden="true">+</span></summary><div class="archive-list" data-repo-list>{other.map(r=><a href={r.html_url} target="_blank" rel="noopener noreferrer"><span>{r.name}</span><span class="archive-description">{r.description || (r.language ? `${r.language} project` : 'Explore the repository')}</span><span class="archive-language">{r.language || 'Code'}</span></a>)}</div></details>
<p class="data-note" data-data-note>Repository snapshot: October 3, 2026. Stars and releases refresh from GitHub when available.</p>
</section>
<section class="about section" id="about" aria-labelledby="about-title"><div><p class="eyebrow">02 / BEHIND THE CODE</p><div class="about-avatar"><img src="./assets/luca-padovan.jpg" alt="Luca Padovan" width="96" height="96" loading="lazy"/></div><h2 id="about-title">Systems thinker.<br/>Hands-on builder.</h2><div class="about-location"><span class="coordinate">44.49° N / 11.34° E</span><span>Bologna, Italy</span></div></div><div class="about-copy"><p class="about-lead">I believe curiosity is the first quality a good engineer should have. Before the tools, the frameworks, or the code, there's the desire to ask questions and understand how things work.</p><p>I'm a Platform & Senior Software Engineer at QubicaAMF in Bologna, working on the software infrastructure behind bowling and entertainment systems. My work spans embedded Linux and Yocto, system integration, updates, recovery, and CI/CD. I also coordinate project streams and external consultants, connecting the details of implementation with the wider architecture of a platform.</p><p>Programming is both my job and something I choose to do in my spare time. I enjoy experimenting, learning unfamiliar technologies, and following an idea far enough to see what it can become. My open-source projects often start with an everyday annoyance or a simple question: could this work a little better?</p><p>Away from the keyboard, I like manga and anime, getting absorbed in a good TV series, and playing video games. I enjoy the worlds they create, the stories they tell, and the different ways they invite you to explore.</p><p>I also love travelling: discovering new places, stepping outside familiar routines, and coming home with a different perspective. Whether I'm exploring a city, trying a new game, or building a tool, that same curiosity keeps me moving.</p><p>For me, engineering is a way of looking at the world: paying attention, asking why, and being willing to try something just to learn from it.</p><div class="personal-interests" aria-label="Personal interests"><span>Manga & anime</span><span>TV series</span><span>Travel</span><span>Video games</span><span>Programming & experiments</span></div><div class="work-focus"><div><span>01</span><p><strong>Embedded Linux</strong>Yocto builds, system integration, drivers, and graphics.</p></div><div><span>02</span><p><strong>Platform & delivery</strong>CI/CD infrastructure and repeatable build workflows.</p></div><div><span>03</span><p><strong>Software updates</strong>OTA strategies and device update lifecycles.</p></div></div><div class="expertise"><span>Software design</span><span>Linux & Yocto</span><span>C / C++</span><span>Docker</span><span>Kubernetes</span><span>Observability</span><span>Embedded systems</span><span>OTA updates</span><span>CI/CD</span><span>Go</span><span>Python</span><span>Open source</span></div></div></section>
<section class="experience section" id="experience" aria-labelledby="experience-title"><div class="section-heading"><div><p class="eyebrow">03 / EXPERIENCE</p><h2 id="experience-title">From firmware to platforms.</h2></div><p>A path through embedded systems,<br class="desktop-break"/> software, and infrastructure.</p></div><div class="career-list"><article><div class="career-date">FEB 2024 — PRESENT</div><div><h3>QubicaAMF</h3><p class="career-role">Platform & Senior Software Engineer</p><p>Embedded Linux platforms and system infrastructure, from operating-system customization to updates, recovery, logging, and monitoring. CI/CD, containers, orchestration, observability, cost optimization, and coordination of consultants and project streams.</p></div></article><article><div class="career-date">MAY 2023 — FEB 2024</div><div><h3>QubicaAMF</h3><p class="career-role">Senior Software Engineer</p><p>Software infrastructure and embedded Linux applications for bowling and entertainment systems, including system customization and operational services.</p></div></article><article><div class="career-date">JUL 2021 — MAY 2023</div><div><h3>HiFuture · Teoresi Group</h3><p class="career-role">Software Engineer</p><p>WinForms and WPF human-machine interfaces for biomedical and microelectronics applications, with software requirements specifications and test plans.</p></div></article><article><div class="career-date">APR 2019 — JUL 2021</div><div><h3>T3LAB</h3><p class="career-role">Software & Firmware Engineer</p><p>C/C++ applications, deployment, and functional testing on ARM multicore SoCs running embedded Linux. Open-source cloud infrastructure with OpenStack, PackStack, Kubernetes, and federated authentication for the SBDIO I4.0 project.</p></div></article><article><div class="career-date">OCT 2018 — MAR 2019</div><div><h3>Datalogic</h3><p class="career-role">Student Internship</p><p>Master's thesis work on “Machine Learning Platforms for Mobile Computing”.</p></div></article></div><div class="education-grid"><div><p class="eyebrow">EDUCATION</p><h3>University of Ferrara</h3><p>Master's degree in Computer and Automation Engineering <span>2016–2018</span></p><p>Bachelor's degree in Computer and Electronic Engineering <span>2012–2016</span></p></div></div></section><section class="credentials section" id="credentials" aria-labelledby="credentials-title"><div class="section-heading"><div><p class="eyebrow">04 / CERTIFICATIONS & TRAINING</p><h2 id="credentials-title">Always learning.</h2></div><p>Formal foundations.<br class="desktop-break"/> A habit of staying curious.</p></div><div class="credentials-grid"><article class="credential"><div class="credential-top"><span class="credential-symbol" aria-hidden="true">Py</span><span class="credential-kind">CERTIFICATION</span></div><h3>PCAP</h3><p>Certified Associate in Python Programming</p><span class="credential-topic">Python programming</span></article><article class="credential"><div class="credential-top"><span class="credential-symbol" aria-hidden="true">C++</span><span class="credential-kind">CERTIFICATION</span></div><h3>CPA</h3><p>C++ Certified Associate Programmer Certification</p><span class="credential-topic">C++ programming</span></article><article class="credential"><div class="credential-top"><span class="credential-symbol" aria-hidden="true">&gt;_</span><span class="credential-kind">TRAINING</span></div><h3>LDF450</h3><p>Embedded Linux Development</p><span class="credential-topic">The Linux Foundation</span></article><article class="credential"><div class="credential-top"><span class="credential-symbol" aria-hidden="true">Yo</span><span class="credential-kind">TRAINING</span></div><h3>Linux & Yocto</h3><p>Linux embedded and Yocto Project course</p><span class="credential-topic">Embedded systems</span></article></div></section><section class="contact section" id="contact" aria-labelledby="contact-title"><p class="eyebrow">05 / KEEP IN TOUCH</p><div class="contact-row"><div><h2 id="contact-title">Good software starts<br/>with a conversation.</h2><p>Have a question, an idea, or a shared interest?<br/>Let's talk on LinkedIn, or build something on GitHub.</p></div><div class="contact-actions"><a class="button primary" href="https://www.linkedin.com/in/lucapadovan/" target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a><a class="button secondary" href="https://github.com/padovanl" target="_blank" rel="noopener noreferrer">Explore my GitHub</a></div></div></section>
</main><footer><span>© {new Date().getFullYear()} Luca Padovan</span><span>Built with Astro. Fueled by curiosity.</span><a href="#main">Back to top</a></footer>
</div><script is:inline src="./live.js" defer></script>
</body></html>
<style is:global>
:root{color-scheme:dark;--bg:#111626;--panel:#1a2237;--line:#ffffff12;--text:#f5f5fc;--muted:#b0b8cf;--accent:#c1b3ff;--cyan:#a6d8f4;--mono:ui-monospace,SFMono-Regular,Consolas,monospace;--sans:'Segoe UI',Inter,Arial,sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:32px}body{margin:0;background:radial-gradient(ellipse at 85% 5%,#31305175 0,transparent 38%),radial-gradient(ellipse at 0 38%,#213a5050 0,transparent 35%),var(--bg);color:var(--text);font-family:var(--sans);font-size:16px;line-height:1.7}::selection{background:var(--accent);color:var(--bg)}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid var(--cyan);outline-offset:6px}a:hover{color:var(--cyan)}.page-shell{max-width:1320px;margin:auto;padding:0 56px}.skip{position:absolute;top:-100px;left:20px;border-radius:12px;background:var(--accent);color:var(--bg);padding:12px;z-index:10}.skip:focus{top:10px}header{height:100px;display:flex;align-items:center;justify-content:space-between;gap:24px}.wordmark{display:flex;align-items:center;gap:12px}.mark{width:44px;height:44px;border-radius:16px;background:var(--accent);color:#25203e;display:grid;place-items:center;font-size:23px;font-weight:750;letter-spacing:-1px}.brand-name{font-size:16px;font-weight:600;letter-spacing:-.3px}nav{display:flex;gap:8px;background:#ffffff05;padding:6px;border:1px solid var(--line);border-radius:999px}nav a{font-size:14px;padding:7px 18px;border-radius:999px;transition:background .2s}nav a:hover{background:#ffffff09;color:var(--text)}.header-gh{border:1px solid #ffffff20;border-radius:999px;padding:9px 21px;font-size:14px}.hero{padding:65px 0 90px;display:grid;grid-template-columns:1.4fr 1fr;gap:72px;align-items:center}.eyebrow{display:flex;gap:20px;color:var(--accent);font:12px var(--mono);letter-spacing:1.5px;margin:0 0 26px}.location{color:var(--muted)}.hello{font-size:21px;margin:0 0 20px;color:#d0d5e5}h1{font-size:clamp(44px,5vw,70px);line-height:1.09;letter-spacing:-3px;font-weight:650;margin:0 0 26px}h1 span{color:var(--accent)}.intro{font-size:18px;color:var(--muted);max-width:565px;line-height:1.85;margin:0 0 30px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.button{padding:14px 24px;font-size:15px;font-weight:600;border-radius:999px;border:1px solid #ffffff24;display:inline-flex;justify-content:center;align-items:center;transition:background .2s,transform .2s,box-shadow .2s}.primary{background:var(--accent);color:#27203f;border-color:transparent;box-shadow:0 8px 28px #ac93ff15}.primary:hover{background:#d2c7ff;color:#27203f;transform:translateY(-3px);box-shadow:0 12px 30px #ac93ff28}.secondary{background:#ffffff05}.secondary:hover{background:#ffffff0d;color:var(--text);transform:translateY(-3px)}.linkedin-hero{display:inline-block;color:var(--muted);font-size:14px;margin-top:18px;text-decoration:underline;text-underline-offset:5px;text-decoration-color:#ffffff25}.hero-foot{display:flex;gap:8px;flex-wrap:wrap;margin-top:30px}.hero-foot span{font-size:11px;letter-spacing:.7px;border-radius:999px;background:#ffffff06;padding:6px 12px;color:#c5ccdf}.hero-portrait{position:relative;padding-bottom:34px;max-width:430px;width:100%;justify-self:end}.photo-frame{position:relative;border-radius:38px;overflow:hidden;border:7px solid #ffffff0c;background:#222d39;box-shadow:0 30px 80px #00000035;transform:rotate(3deg);aspect-ratio:.91}.photo-frame img{width:100%;height:100%;object-fit:cover;display:block}.photo-caption{position:absolute;inset:auto 0 0;padding:60px 25px 26px;background:linear-gradient(transparent,#141d2ccf 55%,#141d2cf5);display:flex;flex-direction:column;gap:3px}.photo-caption strong{font-size:30px;line-height:1.3;font-weight:600;letter-spacing:-.6px}.photo-caption>span:last-child{font-size:14px;color:#c9d3e4}.caption-label{font:10px/1.8 var(--mono);letter-spacing:1px;color:#e0d6ff}.portrait-note{position:absolute;bottom:0;left:-35px;display:flex;align-items:center;gap:14px;padding:18px 24px;background:#