---
import { content, cvPath, type Language } from '../data/content';
const { lang } = Astro.props as { lang: Language };
---
<a class="button secondary cv-button" href={cvPath(lang)} download>
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
    <path d="M14 2v6h6M12 11v7m-3-3 3 3 3-3" />
  </svg>
  <span>{content[lang].download}</span>
  <span class="cv-format">PDF</span>
</a>
