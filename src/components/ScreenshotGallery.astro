---
import type { Language } from '../data/content';
interface Shot { image: string; alt: string; title: string }
const { shots, lang } = Astro.props as { shots: Shot[]; lang: Language };
const enlarge = lang === 'en' ? 'Enlarge screenshot' : 'Ingrandisci screenshot';
---
<div class="screenshot-gallery" data-gallery>
  <button class="project-image screenshot-open" type="button" data-zoom data-images={JSON.stringify(shots)} data-index="0" data-zoom-label={enlarge} aria-label={`${enlarge}: ${shots[0].alt}`}>
    <img src={shots[0].image} alt={shots[0].alt} width="1600" height="900" loading="lazy" />
    <span class="zoom-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg></span>
  </button>
  {shots.length > 1 && <div class="screenshot-tabs" role="group" aria-label={lang === 'en' ? 'Choose screenshot' : 'Scegli screenshot'}>{shots.map((shot, index) => <button type="button" data-shot={index} aria-pressed={index === 0}><img src={shot.image} alt="" width="48" height="27" loading="lazy" /><span>{shot.title}</span></button>)}</div>}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(gallery => {
    const main = gallery.querySelector<HTMLButtonElement>('[data-zoom]')!;
    const image = main.querySelector('img')!;
    const shots = JSON.parse(main.dataset.images!) as { image: string; alt: string; title: string }[];
    gallery.querySelectorAll<HTMLButtonElement>('[data-shot]').forEach(tab => {
      tab.addEventListener('click', () => {
        const index = Number(tab.dataset.shot);
        main.dataset.index = String(index);
        image.src = shots[index].image;
        image.alt = shots[index].alt;
        main.setAttribute('aria-label', `${main.dataset.zoomLabel}: ${shots[index].alt}`);
        gallery.querySelectorAll('[data-shot]').forEach(button => button.setAttribute('aria-pressed', String(button === tab)));
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) image.animate([{ opacity: .4 }, { opacity: 1 }], { duration: 220 });
      });
    });
  });
</script>
